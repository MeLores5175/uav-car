<launch>
  <arg name="mission_yaml" default="$(find d26_air_ground_uav)/config/air_ground_mission.yaml" />
  <arg name="mission_type" default="dynamic_land" />
  <arg name="car_speed" default="0.12" />
  <arg name="auto_start" default="false" />

  <!-- MAVROS/Faster-LIO/SITL 由用户原有 RflySim 环境启动，本 launch 只启动任务节点。 -->
  <node pkg="d26_air_ground_uav"
        type="air_ground_mission_fsm.py"
        name="air_ground_mission_fsm"
        output="screen">
    <param name="mission_yaml" value="$(arg mission_yaml)" />
  </node>

  <node pkg="d26_air_ground_uav"
        type="car_state_simulator.py"
        name="car_state_simulator"
        output="screen">
    <param name="mission_yaml" value="$(arg mission_yaml)" />
    <param name="mission_type" value="$(arg mission_type)" />
    <param name="speed" value="$(arg car_speed)" />
    <param name="auto_start" value="$(arg auto_start)" />
  </node>

  <!-- SITL 中默认不打开真实相机和真实投放串口。 -->
  <node pkg="d26_air_ground_uav"
        type="drop_actuator_serial.py"
        name="drop_actuator_serial"
        output="screen">
    <param name="mission_yaml" value="$(arg mission_yaml)" />
    <param name="simulate" value="true" />
  </node>
</launch>
