<launch>
  <!-- 2026 D题实飞一键启动 -->
  <arg name="start_mavros" default="true" />
  <arg name="start_livox" default="true" />
  <arg name="start_faster_lio" default="true" />
  <arg name="start_fsm" default="true" />
  <arg name="start_vision" default="true" />
  <arg name="start_udp_gateway" default="true" />
  <arg name="start_drop_actuator" default="true" />
  <!-- 旧版原始 JSON 桥接节点仅用于兼容调试，正式 V1.1 默认关闭。 -->
  <arg name="start_legacy_car_udp" default="false" />
  <arg name="start_legacy_status_udp" default="false" />

  <arg name="mission_yaml" default="$(find d26_air_ground_uav)/config/air_ground_mission.yaml" />

  <!-- 沿用原 FS-J310 上已经验证过的 MAVROS 串口配置 -->
  <arg name="fcu_url" default="/dev/ttyTHS0:921600" />
  <arg name="gcs_url" default="" />
  <arg name="tgt_system" default="1" />
  <arg name="tgt_component" default="1" />

  <include if="$(arg start_mavros)" file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="$(arg fcu_url)" />
    <arg name="gcs_url" value="$(arg gcs_url)" />
    <arg name="tgt_system" value="$(arg tgt_system)" />
    <arg name="tgt_component" value="$(arg tgt_component)" />
  </include>

  <include if="$(arg start_livox)" file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch" />
  <include if="$(arg start_faster_lio)" file="$(find faster_lio)/launch/rflysim.launch" />

  <node if="$(arg start_fsm)"
        pkg="d26_air_ground_uav"
        type="air_ground_mission_fsm.py"
        name="air_ground_mission_fsm"
        output="screen">
    <param name="mission_yaml" value="$(arg mission_yaml)" />
  </node>

  <node if="$(arg start_vision)"
        pkg="d26_air_ground_uav"
        type="landing_marker_vision.py"
        name="landing_marker_vision"
        output="screen">
    <param name="mission_yaml" value="$(arg mission_yaml)" />
  </node>

  <node if="$(arg start_udp_gateway)"
        pkg="d26_air_ground_uav"
        type="uav_udp_gateway.py"
        name="uav_udp_gateway"
        output="screen">
    <param name="mission_yaml" value="$(arg mission_yaml)" />
  </node>

  <node if="$(arg start_legacy_car_udp)"
        pkg="d26_air_ground_uav"
        type="car_udp_bridge.py"
        name="car_udp_bridge_legacy"
        output="screen">
    <param name="mission_yaml" value="$(arg mission_yaml)" />
  </node>

  <node if="$(arg start_drop_actuator)"
        pkg="d26_air_ground_uav"
        type="drop_actuator_serial.py"
        name="drop_actuator_serial"
        output="screen">
    <param name="mission_yaml" value="$(arg mission_yaml)" />
  </node>

  <node if="$(arg start_legacy_status_udp)"
        pkg="d26_air_ground_uav"
        type="status_udp_sender.py"
        name="status_udp_sender_legacy"
        output="screen">
    <param name="mission_yaml" value="$(arg mission_yaml)" />
  </node>
</launch>
